{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/blog",
        "http://localhost:3000/blog/agent-delivery-harness",
        "http://localhost:3000/about",
        "http://localhost:3000/work",
        "http://localhost:3000/learn",
        "http://localhost:3000/learn/patterns",
        "http://localhost:3000/learn/toolkit",
        "http://localhost:3000/learn/harness"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": [
          "error",
          { "minScore": 1.0, "aggregationMethod": "pessimistic" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 1.0, "aggregationMethod": "pessimistic" }
        ],
        "categories:seo": ["error", { "minScore": 1.0, "aggregationMethod": "pessimistic" }],
        "color-contrast": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "button-name": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "image-alt": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "link-name": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "aria-prohibited-attr": ["error", { "minScore": 1, "aggregationMethod": "pessimistic" }],
        "label-content-name-mismatch": [
          "error",
          { "minScore": 1, "aggregationMethod": "pessimistic" }
        ]
      }
    }
  }
}
