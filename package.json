{
  "name": "dak-dev",
  "version": "1.0.0",
  "description": "Dakota Smith's writing and field notes on accountable AI systems, innovation strategy, and delivery engineering.",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "analyze": "ANALYZE=true next build --webpack",
    "validate:content": "tsx scripts/validate-posts.ts",
    "validate:content:all": "tsx scripts/validate-posts.ts --all",
    "validate:toolkit": "tsx scripts/validate-toolkit.ts",
    "images:generate": "tsx scripts/generate-post-images.ts",
    "images:generate:all": "tsx scripts/generate-post-images.ts --all",
    "images:process": "tsx scripts/generate-post-images.ts",
    "images:validate": "tsx scripts/generate-post-images.ts --check",
    "images:check": "tsx scripts/generate-post-images.ts --check",
    "images:placeholder": "tsx scripts/generate-post-images.ts",
    "thumbnail:create": "tsx scripts/generate-post-images.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "brand:check": "tsx scripts/generate-brand-assets.ts --check",
    "resume:generate": "tsx scripts/generate-resume-pdf.ts",
    "rss:test": "tsx --test tests/rss.test.ts",
    "test:search": "tsx --test tests/search.test.ts",
    "publish:prepare": "tsx scripts/publish-prepare.ts",
    "publish:prepare:fix": "tsx scripts/publish-prepare.ts --fix",
    "publish:prepare:all": "tsx scripts/publish-prepare.ts --all",
    "generate:og": "tsx scripts/generate-brand-assets.ts --asset og-default"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smithdak/dak-dev.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.22.2"
  },
  "bugs": {
    "url": "https://github.com/smithdak/dak-dev/issues"
  },
  "homepage": "https://daksmith.dev",
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.5",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "fontkit": "2.0.4",
    "lighthouse": "13.4.1",
    "pdfkit": "^0.19.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "6.0.3"
  }
}
